{
  "manifest_version": 3,
  "name": "RJ番号リンカー (for DLsite)",
  "short_name": "RJ番号リンカー",
  "version": "1.1.0",
  "description": "SNS等に書かれた DLsite の作品番号 (RJ/RE/VJ/BJ) を作品ページへのリンクに変換します。※非公式ツールです。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "RJ番号リンカー",
    "default_popup": "popup.html"
  },
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://bsky.app/*",
        "https://www.pixiv.net/*",
        "https://*.5ch.net/*",
        "https://misskey.io/*",
        "https://www.youtube.com/*",
        "https://ch.dlsite.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
